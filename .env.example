SESSION_SECRET=PlanoB2026

DB_HOST=
DB_USER=root
DB_PASSWORD=
DB_NAME=railway
DB_PORT=3306
DB_SSL=false

# Endereço público do site. Usado no link do e-mail de recuperação de senha.
# Ex.: https://planob.onrender.com   (local: http://localhost:3000)
APP_URL=http://localhost:3000

# WhatsApp do suporte: só números, com DDI e DDD. Ex.: 5511912345678
# Se ficar vazio, o botão de WhatsApp some da tela de suporte.
WHATSAPP_SUPORTE=

# E-mail (recuperação de senha). Sem SMTP_HOST, o link aparece só no terminal do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PlanoB <seu-email@gmail.com>"
