<%# Rodapé padrão do menu lateral (canto inferior esquerdo) de TODAS as páginas de aluno e professor.
    Para mudar o visual ou o texto do botão Sair, mude só este arquivo. %>
<style>
  .menu-sair-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 9999px;
    color: #505a81;
    font-family: 'Manrope', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25rem;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  /* No menu de vídeos (CSS próprio, sem Tailwind) os links não têm gap do flex */
  .sidebar-footer .menu-sair-link + .menu-sair-link {
    margin-top: 0.5rem;
  }

  .menu-sair-link em {
    font-style: normal;
  }

  .menu-sair-link:hover {
    background-color: #e4e7ff;
  }

  .menu-sair-link:active {
    transform: scale(0.95);
  }

  .menu-sair-link--sair:hover {
    color: #b31b25;
  }

  .menu-sair-link--suporte:hover {
    color: #0058ba;
  }

  .menu-sair-link:focus-visible {
    outline: 2px solid #0058ba;
    outline-offset: 2px;
  }
</style>

<a class="menu-sair-link menu-sair-link--suporte" href="/suporte">
  <i class="material-symbols-outlined not-italic" aria-hidden="true">support_agent</i>
  <em>Suporte</em>
</a>

<a class="menu-sair-link menu-sair-link--sair" href="/logout">
  <i class="material-symbols-outlined not-italic" aria-hidden="true">logout</i>
  <em>Sair</em>
</a>
