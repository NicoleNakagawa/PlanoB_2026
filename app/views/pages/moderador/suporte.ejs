<%- include('../../partials/moderador/topo', { titulo: 'Suporte' }) %>

<%
  const voltar = '/moderador/suporte' + fmt.qs(Object.assign({}, filtros, { pagina: paginacao.pagina > 1 ? paginacao.pagina : '' }))
  const corBorda = { aberto: 'border-amber-400', em_atendimento: 'border-sky-400', resolvido: 'border-green-500', fechado: 'border-outline-variant' }
%>

<header>
  <h1 class="text-3xl md:text-4xl font-black headline">Suporte</h1>
  <p class="text-on-surface-variant mt-1">Chamados enviados pelos usuários. Os mais urgentes aparecem primeiro.</p>
</header>

<nav class="flex flex-wrap gap-2" aria-label="Filtro por status">
  <a href="/moderador/suporte" class="px-4 py-2 rounded-full text-sm font-bold <%= !filtros.status ? 'bg-primary text-white' : 'bg-surface-container-lowest hover:bg-surface-container' %>">Todos</a>
  <% statusLista.forEach(function(s) { %>
    <a href="/moderador/suporte?status=<%= s %>" class="px-4 py-2 rounded-full text-sm font-bold <%= filtros.status === s ? 'bg-primary text-white' : 'bg-surface-container-lowest hover:bg-surface-container' %>">
      <%= fmt.rotuloStatus(s) %> <span class="opacity-70">(<%= contagens[s] %>)</span>
    </a>
  <% }) %>
</nav>

<section class="flex flex-col gap-4">
  <% if (chamados.length > 0) { %>
    <% chamados.forEach(function(c) { %>
      <article class="bg-surface-container-lowest rounded-3xl p-6 shadow-sm border-l-4 <%= corBorda[c.status] || 'border-outline-variant' %>">
        <header class="flex flex-col md:flex-row md:items-start justify-between gap-3 mb-3">
          <div class="min-w-0">
            <h2 class="text-lg font-black headline"><%= c.assunto || 'Sem assunto' %></h2>
            <p class="text-sm text-on-surface-variant">
              <% if (c.id_aluno) { %><a href="/moderador/alunos/<%= c.id_aluno %>" class="font-bold hover:text-primary"><%= c.nome %></a><% } else { %><strong><%= c.nome %></strong><% } %>
              • <%= c.email %> • <%= fmt.dataHora(c.criado_em) %> (<%= fmt.tempoRelativo(c.criado_em) %>)
            </p>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-black self-start <%= fmt.classeStatus(c.status) %>"><%= fmt.rotuloStatus(c.status) %></span>
        </header>

        <p class="text-sm leading-relaxed whitespace-pre-line bg-surface-container-low rounded-2xl p-4"><%= c.mensagem %></p>

        <footer class="flex flex-wrap items-center gap-2 mt-4">
          <a href="mailto:<%= c.email %>?subject=<%= encodeURIComponent('Re: ' + (c.assunto || 'Suporte PlanoB')) %>"
             class="inline-flex items-center gap-1 rounded-full bg-primary text-white px-4 py-2 text-xs font-black active:scale-95 transition-transform">
            <i class="material-symbols-outlined text-base not-italic" aria-hidden="true">mail</i> Responder por e-mail
          </a>

          <% statusLista.filter(function(s) { return s !== c.status }).forEach(function(s) { %>
            <form action="/moderador/suporte/<%= c.id_suporte %>/status" method="POST">
              <input type="hidden" name="status" value="<%= s %>" />
              <input type="hidden" name="voltar" value="<%= voltar %>" />
              <button type="submit" class="rounded-full bg-surface-container-low hover:bg-surface-container px-4 py-2 text-xs font-black transition-colors">
                Marcar como <%= fmt.rotuloStatus(s).toLowerCase() %>
              </button>
            </form>
          <% }) %>
        </footer>
      </article>
    <% }) %>
  <% } else { %>
    <div class="bg-surface-container-lowest rounded-3xl px-6 py-14 text-center shadow-sm">
      <i class="material-symbols-outlined text-primary text-5xl not-italic mb-3" aria-hidden="true">inbox</i>
      <p class="font-black">Nenhum chamado por aqui</p>
      <p class="text-sm text-on-surface-variant mt-1">Quando um usuário enviar uma mensagem de suporte, ela aparece nesta tela.</p>
    </div>
  <% } %>
</section>

<section class="bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm">
  <%- include('../../partials/moderador/paginacao', { base: '/moderador/suporte' }) %>
</section>

<%- include('../../partials/moderador/rodape') %>
