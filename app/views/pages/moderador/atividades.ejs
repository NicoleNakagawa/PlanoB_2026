<%- include('../../partials/moderador/topo', { titulo: 'Atividades' }) %>

<%
  const info = {
    cadastro_aluno: { rotulo: 'Novos alunos', icone: 'person_add', cor: 'bg-primary/10 text-primary' },
    cadastro_professor: { rotulo: 'Novos professores', icone: 'school', cor: 'bg-secondary/10 text-secondary' },
    pagamento: { rotulo: 'Pagamentos', icone: 'payments', cor: 'bg-green-100 text-green-700' },
    video: { rotulo: 'Vídeos', icone: 'smart_display', cor: 'bg-purple-100 text-purple-700' },
    suporte: { rotulo: 'Suporte', icone: 'support_agent', cor: 'bg-amber-100 text-amber-700' },
    treino: { rotulo: 'Treinos', icone: 'fitness_center', cor: 'bg-sky-100 text-sky-700' },
    acao_moderador: { rotulo: 'Ações de moderadores', icone: 'shield_person', cor: 'bg-red-100 text-red-700' }
  }
  const destino = function (item) {
    if (['cadastro_aluno', 'pagamento', 'treino'].includes(item.tipo)) return '/moderador/alunos/' + item.ref_id
    if (item.tipo === 'cadastro_professor') return '/moderador/professores/' + item.ref_id
    if (item.tipo === 'video') return '/moderador/videos'
    if (item.tipo === 'suporte') return '/moderador/suporte'
    return ''
  }
%>

<header>
  <h1 class="text-3xl md:text-4xl font-black headline">Atividades</h1>
  <p class="text-on-surface-variant mt-1">Linha do tempo do que acontece na plataforma, incluindo as ações feitas por moderadores.</p>
</header>

<nav class="flex flex-wrap gap-2" aria-label="Filtro por tipo">
  <a href="/moderador/atividades" class="px-4 py-2 rounded-full text-sm font-bold <%= !filtros.tipo ? 'bg-primary text-white' : 'bg-surface-container-lowest hover:bg-surface-container' %>">Tudo</a>
  <% tipos.forEach(function(t) { %>
    <a href="/moderador/atividades?tipo=<%= t %>" class="px-4 py-2 rounded-full text-sm font-bold <%= filtros.tipo === t ? 'bg-primary text-white' : 'bg-surface-container-lowest hover:bg-surface-container' %>"><%= info[t].rotulo %></a>
  <% }) %>
</nav>

<section class="bg-surface-container-lowest rounded-[2rem] shadow-sm p-4 md:p-6">
  <% if (atividades.length > 0) { %>
    <ul class="flex flex-col divide-y divide-surface-container-low list-none p-0 m-0">
      <% atividades.forEach(function(item) { const i = info[item.tipo] || { rotulo: item.tipo, icone: 'bolt', cor: 'bg-surface-container text-primary' }; const link = destino(item) %>
        <li class="py-4 flex items-center gap-4">
          <span class="w-11 h-11 rounded-full <%= i.cor %> flex items-center justify-center shrink-0">
            <i class="material-symbols-outlined not-italic" aria-hidden="true"><%= i.icone %></i>
          </span>
          <div class="flex-1 min-w-0">
            <p class="font-bold truncate">
              <% if (link) { %><a href="<%= link %>" class="hover:text-primary"><%= item.titulo %></a><% } else { %><%= item.titulo %><% } %>
            </p>
            <p class="text-xs text-on-surface-variant truncate"><%= i.rotulo %><%= item.detalhe ? ' • ' + item.detalhe : '' %></p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-bold"><%= fmt.tempoRelativo(item.quando) %></p>
            <p class="text-[11px] text-on-surface-variant"><%= fmt.dataHora(item.quando) %></p>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="py-14 text-center">
      <i class="material-symbols-outlined text-primary text-5xl not-italic mb-3" aria-hidden="true">history</i>
      <p class="font-black">Nenhuma atividade registrada</p>
    </div>
  <% } %>
</section>

<%- include('../../partials/moderador/rodape') %>
