<%- include('../../partials/moderador/topo', { titulo: 'Professores' }) %>

<header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
  <div>
    <h1 class="text-3xl md:text-4xl font-black headline">Professores</h1>
    <p class="text-on-surface-variant mt-1"><%= paginacao.total %> professor(es) encontrado(s).</p>
  </div>
  <a href="/moderador/exportar" class="inline-flex items-center justify-center gap-2 rounded-full bg-primary text-white px-5 py-3 text-sm font-black active:scale-95 transition-transform">
    <i class="material-symbols-outlined not-italic" aria-hidden="true">download</i> Exportar CSV
  </a>
</header>

<section class="bg-surface-container-lowest rounded-3xl p-5 shadow-sm">
  <form action="/moderador/professores" method="GET" class="flex flex-col lg:flex-row gap-3">
    <div class="relative flex-1">
      <i class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline not-italic" aria-hidden="true">search</i>
      <label for="busca" class="sr-only">Buscar professor</label>
      <input id="busca" name="busca" type="search" value="<%= filtros.busca %>" placeholder="Buscar por nome, e-mail ou CREF..."
             class="w-full rounded-full border-none bg-surface-container-low px-12 py-3 text-sm focus:ring-2 focus:ring-primary" />
    </div>

    <label for="ordem" class="sr-only">Ordenar</label>
    <select id="ordem" name="ordem" class="rounded-full border-none bg-surface-container-low px-5 py-3 text-sm font-bold focus:ring-2 focus:ring-primary">
      <option value="recentes" <%= filtros.ordem === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
      <option value="nome" <%= filtros.ordem === 'nome' ? 'selected' : '' %>>Nome (A-Z)</option>
      <option value="alunos" <%= filtros.ordem === 'alunos' ? 'selected' : '' %>>Mais alunos</option>
      <option value="videos" <%= filtros.ordem === 'videos' ? 'selected' : '' %>>Mais vídeos</option>
    </select>

    <button type="submit" class="rounded-full bg-on-surface text-white px-6 py-3 text-sm font-black active:scale-95 transition-transform">Filtrar</button>
  </form>
</section>

<section class="bg-surface-container-lowest rounded-[2rem] shadow-sm overflow-hidden">
  <div class="overflow-x-auto rolagem-fina">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-surface-container/50">
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">Professor</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">CREF</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">Alunos</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">Vídeos</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">Fichas</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant">Cadastro</th>
          <th class="px-6 py-4 text-xs font-black uppercase tracking-widest text-on-surface-variant text-right">Perfil</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-surface-container-low">
        <% if (professores.length > 0) { %>
          <% professores.forEach(function(prof) { %>
            <tr class="hover:bg-primary/5 transition-colors group">
              <td class="px-6 py-4">
                <a href="/moderador/professores/<%= prof.id_professor %>" class="flex items-center gap-4">
                  <%- include('../../partials/moderador/avatar', { foto: prof.foto_perfil, nome: prof.nome, tam: 'w-11 h-11' }) %>
                  <div class="min-w-0">
                    <p class="font-black group-hover:text-primary transition-colors truncate"><%= prof.nome %></p>
                    <p class="text-xs text-on-surface-variant truncate"><%= prof.email %></p>
                  </div>
                </a>
              </td>
              <td class="px-6 py-4"><span class="px-3 py-1 rounded-full text-xs font-black bg-secondary text-white"><%= prof.cref %></span></td>
              <td class="px-6 py-4 text-sm font-bold"><%= prof.alunos %></td>
              <td class="px-6 py-4 text-sm font-bold"><%= prof.videos %></td>
              <td class="px-6 py-4 text-sm font-bold"><%= prof.fichas %></td>
              <td class="px-6 py-4 text-sm text-on-surface-variant whitespace-nowrap"><%= fmt.dataCurta(prof.criado_em) %></td>
              <td class="px-6 py-4 text-right">
                <a href="/moderador/professores/<%= prof.id_professor %>" class="inline-flex items-center gap-1 rounded-full bg-surface-container-low hover:bg-primary hover:text-white px-4 py-2 text-xs font-black transition-colors">
                  Ver perfil <i class="material-symbols-outlined text-base not-italic" aria-hidden="true">chevron_right</i>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="px-6 py-14 text-center">
              <i class="material-symbols-outlined text-primary text-5xl not-italic mb-3" aria-hidden="true">search_off</i>
              <p class="font-black">Nenhum professor encontrado</p>
              <p class="text-sm text-on-surface-variant mt-1">Tente mudar a busca.</p>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <%- include('../../partials/moderador/paginacao', { base: '/moderador/professores' }) %>
</section>

<%- include('../../partials/moderador/rodape') %>
