<!DOCTYPE html>
<html lang="pt-BR" class="light">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>PlanoB - Cadastro Aluno</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;700;800;900&family=Manrope:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />

  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            primary: "#0058ba",
            "primary-container": "#6c9fff",
            "primary-dim": "#004da4",
            "on-primary": "#f0f2ff",
            surface: "#f7f5ff",
            "on-surface": "#232c51",
            "on-surface-variant": "#505a81",
            "surface-container": "#e4e7ff",
            "surface-container-low": "#efefff",
            "surface-container-high": "#dde1ff",
            "surface-container-highest": "#d5dbff",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#a2abd7",
            outline: "#6c759e",
            "tertiary-fixed": "#ffd709",
            error: "#b31b25"
          },
          fontFamily: {
            headline: ["Lexend"],
            body: ["Manrope"]
          }
        }
      }
    }
  </script>

  <style>


    @font-face {
      font-family: 'Baumans';
      src: url('/fonts/Baumans-Regular.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    body {
      font-family: "Manrope", sans-serif;
    }

    h1,
    h2,
    h3,
    .headline {
      font-family: "Lexend", sans-serif;
    }

    .logo-font {
      font-family: 'Baumans', sans-serif !important;
      font-weight: 400 !important;
      letter-spacing: 0.02em;
    }

    .material-symbols-outlined {
      font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
      vertical-align: middle;
    }

    @media (max-width: 640px) {
      section.form-area {
        padding: 2rem 1.25rem !important;
      }

      h1.page-title,
      h3.page-title {
        font-size: 2.25rem !important;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/transicao-paginas.css">
</head>

<body class="min-h-screen overflow-x-hidden bg-surface text-on-surface">

  <main class="grid min-h-screen w-full bg-surface-container-lowest lg:grid-cols-2 xl:grid-cols-[1.05fr_0.95fr]">

    <aside class="relative hidden overflow-hidden bg-neutral-900 lg:flex">
      <picture>
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-ucD8BXcQBtF9lwoWkG9ILtmvn39xeC70rBb47fvAKJY4MHRVUGiKwHa79b2JxmddKza3IxwtCpXiYtctaGgh8PHEskTN5WMTIxvu46_a-2N-g3HYswt0Gmm4kBqA5ACLxdZCil7iNFiIjdHm8vVzYMbo4sfw_rF8yVNVSbL1-ZZv0RAoU4SvaTVa3i1NKGlMEsPHPBqn_OW9G1NjS387ayz8Hqv1vahZdPsKHfFobCzpoP0Porh3zKaaJXfMxJDbK42UkPnQDdIX"
          alt="Ambiente fitness PlanoB"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>

      <b class="absolute inset-0 bg-gradient-to-tr from-black/70 via-black/35 to-transparent font-normal" aria-hidden="true"></b>

      <header class="relative z-10 flex h-full w-full flex-col justify-end p-12 xl:p-20">
        <p class="mb-5 text-sm font-black tracking-widest text-tertiary-fixed">PLANO B</p>

        <h1 class="headline max-w-2xl text-6xl font-black leading-[1.05] tracking-tighter text-on-primary xl:text-7xl 2xl:text-8xl">
          MOVA SEU POTENCIAL
        </h1>

        <p class="mt-6 max-w-xl text-lg font-semibold leading-relaxed text-on-primary/85 xl:text-xl">
          Crie sua conta de aluno e comece sua jornada fitness com treinos, progresso e acompanhamento.
        </p>
      </header>
    </aside>

    <section class="form-area flex min-h-screen w-full flex-col bg-surface-container-lowest px-8 py-10 md:px-16 lg:px-20 xl:px-28 2xl:px-36">

      <nav aria-label="Navegação de retorno">
        <a href="/home" class="group inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-primary transition-opacity hover:opacity-80">
          <i class="material-symbols-outlined text-lg transition-transform group-hover:-translate-x-1 not-italic" aria-hidden="true">arrow_back</i>
          Voltar
        </a>
      </nav>

      <header class="mt-10 flex items-center justify-between">
        <h2 class="logo-font text-3xl text-primary md:text-4xl">PlanoB</h2>

        <p class="hidden rounded-full bg-surface-container px-5 py-2 text-xs font-black uppercase tracking-widest text-on-surface-variant sm:block">
          Cadastro aluno
        </p>
      </header>

      <section class="mx-auto flex w-full max-w-[30rem] flex-1 flex-col justify-center py-10">

        <header class="mb-10">
          <h3 class="page-title headline text-4xl font-black tracking-tight text-on-surface md:text-5xl">
            Criar conta
          </h3>

          <p class="mt-3 text-base font-semibold leading-relaxed text-on-surface-variant">
            Preencha os dados abaixo para começar sua jornada fitness.
          </p>
        </header>

        <% if (locals.erro) { %>
          <p class="mb-5 rounded-2xl bg-red-50 px-4 py-3 text-center text-sm font-bold text-error" role="alert">
            <%= erro %>
          </p>
        <% } %>

        <% if (locals.sucesso) { %>
          <p class="mb-5 rounded-2xl bg-green-50 px-4 py-3 text-center text-sm font-bold text-green-700" role="status">
            <%= sucesso %>
          </p>
        <% } %>

        <form class="space-y-6" action="/cadastroaluno" method="POST" data-form="cadastroaluno" aria-label="Formulário de cadastro de aluno" novalidate>

          <fieldset class="space-y-2">
            <legend class="sr-only">Nome completo</legend>

            <label for="name" class="ml-1 block text-sm font-bold text-on-surface-variant">
              Nome completo
            </label>

            <article class="relative">
              <i class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline not-italic" aria-hidden="true">person</i>

              <input
                id="name"
                name="name"
                type="text"
                placeholder="Seu nome completo"
                autocomplete="name"
                class="w-full rounded-2xl border-none bg-surface-container-highest py-4 pl-12 pr-4 text-on-surface transition-all placeholder:text-outline focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary"
                required
              />
            </article>
          </fieldset>

          <fieldset class="space-y-2">
            <legend class="sr-only">E-mail</legend>

            <label for="email" class="ml-1 block text-sm font-bold text-on-surface-variant">
              E-mail
            </label>

            <article class="relative">
              <i class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline not-italic" aria-hidden="true">mail</i>

              <input
                id="email"
                name="email"
                type="email"
                placeholder="seu@email.com"
                autocomplete="email"
                class="w-full rounded-2xl border-none bg-surface-container-highest py-4 pl-12 pr-4 text-on-surface transition-all placeholder:text-outline focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary"
                required
              />
            </article>
          </fieldset>

          <fieldset class="space-y-2">
            <legend class="sr-only">Senha</legend>

            <label for="password" class="ml-1 block text-sm font-bold text-on-surface-variant">
              Senha
            </label>

            <article class="relative">
              <i class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline not-italic" aria-hidden="true">lock</i>

              <input
                id="password"
                name="password"
                type="password"
                placeholder="••••••••"
                autocomplete="new-password"
                class="w-full rounded-2xl border-none bg-surface-container-highest py-4 pl-12 pr-12 text-on-surface transition-all placeholder:text-outline focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary"
                required
              />

              <button
                type="button"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-outline transition-colors hover:text-primary"
                aria-label="Mostrar ou ocultar senha"
                data-password-toggle="password"
              >
                <i class="material-symbols-outlined not-italic" aria-hidden="true">visibility</i>
              </button>
            </article>
          </fieldset>

          <section id="password-requirements" class="-mt-3 rounded-xl bg-surface-container-low p-4 text-xs text-on-surface-variant" aria-live="polite">
            <p class="mb-2 font-bold">A senha deve conter:</p>
            <ul class="space-y-1">
              <li data-password-rule="length">○ Pelo menos 8 caracteres</li>
              <li data-password-rule="upper">○ Uma letra maiúscula</li>
              <li data-password-rule="lower">○ Uma letra minúscula</li>
              <li data-password-rule="number">○ Um número</li>
            </ul>
          </section>

          <fieldset>
            <legend class="sr-only">Termos de uso</legend>

            <label for="terms" class="flex cursor-pointer items-start gap-3 py-2">
              <input
                id="terms"
                name="terms"
                type="checkbox"
                class="mt-0.5 h-5 w-5 rounded border-outline-variant text-primary focus:ring-primary"
                required
              />

              <em class="text-sm leading-relaxed text-on-surface-variant not-italic">
                Eu aceito os <button type="button" data-open-policy="termos" class="font-bold text-primary underline">Termos de Uso</button> e a <button type="button" data-open-policy="privacidade" class="font-bold text-primary underline">Política de Privacidade</button>.
              </em>
            </label>
          </fieldset>

          <button
            type="submit"
            class="w-full rounded-full bg-gradient-to-r from-primary to-primary-container py-4 text-lg font-black text-on-primary shadow-lg shadow-primary/25 transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
          >
            Criar minha conta
          </button>

        </form>

        <footer class="mt-10 text-center">
          <p class="text-sm font-semibold text-on-surface-variant">
            Já possui uma conta?
          </p>

          <nav class="mt-4 flex flex-col items-center gap-3" aria-label="Links de acesso">
            <a href="/login" class="rounded-full bg-surface-container px-5 py-3 text-sm font-black text-primary transition-colors hover:bg-surface-container-high">
              Entrar
            </a>

            <p class="pt-2 text-sm font-semibold text-on-surface-variant">Ou <a href="/cadastroprofessor" class="font-black text-primary underline underline-offset-4">criar conta de professor</a></p>
          </nav>
        </footer>

      </section>
    </section>

  </main>

  <dialog id="policy-dialog" class="w-[min(92vw,38rem)] rounded-2xl p-0 shadow-2xl backdrop:bg-black/50">
    <article class="p-6 md:p-8"><header class="flex items-start justify-between gap-4"><h2 id="policy-title" class="text-xl font-black text-on-surface">Termos de Uso</h2><button type="button" id="policy-close" class="rounded-full px-3 py-1 font-bold text-on-surface-variant hover:bg-surface-container" aria-label="Fechar">✕</button></header><div id="policy-content" class="mt-4 space-y-3 text-sm leading-relaxed text-on-surface-variant"></div><button type="button" id="policy-confirm" class="mt-6 w-full rounded-full bg-primary px-5 py-3 font-bold text-white">Entendi</button></article>
  </dialog>
  <script>
    const policyDialog = document.getElementById('policy-dialog');
    const policyTitle = document.getElementById('policy-title');
    const policyContent = document.getElementById('policy-content');
    const policies = {
      termos: { title: 'Termos de Uso', paragraphs: ['Use o PlanoB de forma responsável e forneça informações verdadeiras no cadastro.', 'Os conteúdos de treino são informativos. Respeite seus limites e interrompa o exercício se sentir dor ou mal-estar.', 'Não compartilhe sua senha nem tente acessar dados de outros usuários. Os recursos disponíveis variam conforme o plano.'] },
      privacidade: { title: 'Política de Privacidade', paragraphs: ['Os dados do cadastro são utilizados para autenticação, funcionamento da plataforma e acompanhamento dos treinos.', 'As informações de suporte são usadas para responder às solicitações e prestar atendimento.', 'Para dúvidas sobre seus dados, entre em contato pela página de suporte do PlanoB.'] }
    };
    document.querySelectorAll('[data-open-policy]').forEach(button => button.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); const item = policies[button.dataset.openPolicy]; policyTitle.textContent = item.title; policyContent.replaceChildren(...item.paragraphs.map(text => { const p = document.createElement('p'); p.textContent = text; return p; })); policyDialog.showModal(); }));
    document.getElementById('policy-close')?.addEventListener('click', () => policyDialog.close());
    document.getElementById('policy-confirm')?.addEventListener('click', () => policyDialog.close());
    const passwordInput = document.getElementById('password');
    const rules = { length: value => value.length >= 8, upper: value => /[A-Z]/.test(value), lower: value => /[a-z]/.test(value), number: value => /[0-9]/.test(value) };
    function updatePasswordRules() { if (!passwordInput) return; Object.entries(rules).forEach(([key, test]) => { const item = document.querySelector('[data-password-rule="' + key + '"]'); if (!item) return; const valid = test(passwordInput.value); item.textContent = (valid ? '✓ ' : '○ ') + item.textContent.replace(/^[✓○] /, ''); item.classList.toggle('font-bold', valid); item.classList.toggle('text-green-700', valid); }); }
    passwordInput?.addEventListener('input', updatePasswordRules); updatePasswordRules();
  </script>
  <script>
    document.querySelectorAll('[data-password-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const inputId = button.getAttribute('data-password-toggle')
        const input = document.getElementById(inputId)
        const icon = button.querySelector('.material-symbols-outlined')

        if (!input || !icon) return

        const isPassword = input.type === 'password'

        input.type = isPassword ? 'text' : 'password'
        icon.textContent = isPassword ? 'visibility_off' : 'visibility'
      })
    })
  </script>

  <script src="/js/validacoes.js"></script>
  <script src="/js/transicao-paginas.js"></script>
</body>

</html>