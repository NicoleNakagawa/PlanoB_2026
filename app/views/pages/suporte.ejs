      ['Como aumento o tamanho das letras?', 'No menu de acessibilidade, use os botões <strong>A+</strong> e <strong>A−</strong> em "Tamanho do texto".'],
      ['Que outros recursos existem?', 'Alto contraste, fonte para leitura, espaçamento do texto, destaque de links e pausa de animações. Você liga e desliga cada um quando quiser.'],
      ['Como volto ao visual original?', 'No fim do menu de acessibilidade, clique em <strong>Restaurar padrão</strong>.']
    ]}
  ]
%>

    <% const logado = typeof usuarioSuporte !== 'undefined' && usuarioSuporte %>
    <% const novas = typeof respostasNovas !== 'undefined' ? Number(respostasNovas) : 0 %>

    <section class="px-8 py-16 bg-surface-container-low" aria-labelledby="categorias-heading">
      <h2 id="categorias-heading" class="sr-only">Categorias de suporte</h2>

      <article class="max-w-7xl mx-auto">
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5" role="list">
          <% faq.forEach(bloco => { %>
          <li data-support-quick="<%= bloco.id %>" role="link" tabindex="0" class="support-quick group p-6 bg-surface-container-lowest rounded-3xl hover:bg-primary transition-all duration-300 cursor-pointer shadow-sm hover:shadow-xl hover:-translate-y-1">
            <figure class="w-12 h-12 rounded-2xl bg-primary-container/20 flex items-center justify-center mb-4 group-hover:bg-white/20 transition-colors">
              <i class="material-symbols-outlined text-primary text-2xl group-hover:text-white not-italic" aria-hidden="true"><%= bloco.icone %></i>
            </figure>
            <h3 class="font-headline text-lg font-bold mb-1 group-hover:text-white"><%= bloco.titulo %></h3>
            <p class="font-body text-on-surface-variant group-hover:text-white/80 text-sm"><%= bloco.resumo %></p>
          </li>
          <% }) %>
        </ul>
      </article>
    </section>

    <section class="px-8 py-24" aria-labelledby="faq-heading">
      <article class="max-w-4xl mx-auto">

        <header class="mb-12">
          <h2 id="faq-heading" class="font-headline text-4xl font-black tracking-tight text-on-surface mb-4">Perguntas Frequentes</h2>
          <p class="font-body text-on-surface-variant text-lg">Respostas para as dúvidas mais comuns sobre como usar o PlanoB. Use a busca ou escolha um tema.</p>
        </header>

        <% faq.forEach(bloco => { %>
        <section id="faq-bloco-<%= bloco.id %>" data-faq-bloco class="faq-bloco mb-14 scroll-mt-28" aria-labelledby="faq-titulo-<%= bloco.id %>">
          <header class="flex items-center gap-4 mb-6">
            <figure class="w-12 h-12 rounded-2xl bg-primary-container/20 flex items-center justify-center shrink-0">
              <i class="material-symbols-outlined text-primary text-2xl not-italic" aria-hidden="true"><%= bloco.icone %></i>
            </figure>
            <hgroup>
              <h3 id="faq-titulo-<%= bloco.id %>" class="font-headline text-2xl font-black text-on-surface"><%= bloco.titulo %></h3>
              <p class="font-body text-sm text-on-surface-variant"><%= bloco.resumo %></p>
            </hgroup>
          </header>

          <ul class="space-y-3" role="list">
            <% bloco.itens.forEach((item, n) => { %>
            <li id="faq-<%= bloco.id %>-<%= n + 1 %>" data-faq-item>
              <details class="group bg-surface-container rounded-3xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between gap-4 p-6 md:p-7 cursor-pointer select-none">
                  <h4 class="font-headline text-lg font-bold text-on-surface"><%= item[0] %></h4>
                  <i class="material-symbols-outlined text-primary transition-transform group-open:rotate-180 not-italic shrink-0" aria-hidden="true">expand_more</i>
                </summary>
                <p class="px-6 md:px-7 pb-7 font-body text-on-surface-variant leading-relaxed"><%- item[1] %></p>
              </details>
            </li>
            <% }) %>
          </ul>
        </section>
        <% }) %>

        <p id="faq-vazio" class="hidden text-center font-body text-on-surface-variant text-lg py-12" role="status">
          Nenhuma dúvida encontrada para essa busca. Tente outras palavras ou
          <a href="#chamado" class="text-primary font-bold underline">abra um chamado</a>.
        </p>

      </article>
    </section>

    <section id="contato" class="px-8 py-24 bg-on-surface text-surface relative overflow-hidden scroll-mt-20" aria-labelledby="contato-heading">

      <figure class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAkTPKmS6JuzYtDwVJ94ybSMEgBr1po7o3p4VwLips83ehdGjxNHK2WAlogc7GNSM3wykFbGoqeIifzgUw1xVv6dO5QjEC3nVBFdjYR43JNrbMQlBMF6AtTuynTNJ7aPKl8ijd3X_FJFUAbN
          alt=""
          class="w-full h-full object-cover"
        />
      </figure>

      <article class="max-w-7xl mx-auto relative z-10 text-center">

        <h2 id="contato-heading" class="font-headline text-4xl md:text-5xl font-black mb-12 italic">Ainda precisa de ajuda?</h2>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8 justify-center max-w-5xl mx-auto" role="list">

          <li class="bg-surface/10 backdrop-blur-md p-10 rounded-3xl border border-white/10 hover:border-primary transition-colors flex flex-col items-center text-center">
            <i class="material-symbols-outlined text-5xl mb-6 text-primary-fixed not-italic" aria-hidden="true">support_agent</i>
            <h3 class="font-headline text-2xl font-bold mb-4">Abrir chamado</h3>
            <p class="font-body text-surface/70 mb-8">Fale direto com a nossa equipe. A resposta chega aqui no site, em "Meus chamados".</p>
            <% if (logado) { %>
              <a href="#chamado" class="w-full py-4 bg-primary text-on-primary rounded-full font-bold hover:scale-[1.02] transition-transform flex items-center justify-center gap-2">
                Abrir chamado
              </a>
              <a href="/suporte/chamados" class="mt-3 w-full py-3 border border-white/30 text-surface rounded-full font-bold hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
                Meus chamados
                <% if (novas > 0) { %>
                  <mark class="px-2 py-0.5 rounded-full bg-tertiary-container text-on-surface text-xs font-black"><%= novas %> nova<%= novas > 1 ? 's' : '' %></mark>
                <% } %>
              </a>
            <% } else { %>
              <a href="/login?next=%2Fsuporte%23chamado" class="w-full py-4 bg-primary text-on-primary rounded-full font-bold hover:scale-[1.02] transition-transform flex items-center justify-center gap-2">
                Entrar para abrir chamado
              </a>
            <% } %>
          </li>

          <li class="bg-surface/10 backdrop-blur-md p-10 rounded-3xl border border-white/10 hover:border-primary transition-colors flex flex-col items-center text-center">
            <i class="material-symbols-outlined text-5xl mb-6 text-primary-fixed not-italic" aria-hidden="true">mail</i>
            <h3 class="font-headline text-2xl font-bold mb-4">E-mail de Suporte</h3>
            <p class="font-body text-surface/70 mb-8">Para questões mais complexas. Respondemos em até 24 horas úteis.</p>
            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=planobacademia@gmail.com" target="_blank" rel="noopener noreferrer" class="w-full py-4 bg-surface-container-lowest text-on-surface rounded-full font-bold hover:scale-[1.02] transition-transform flex items-center justify-center gap-2">
              Enviar E-mail
            </a>
          </li>

          <li class="bg-surface/10 backdrop-blur-md p-10 rounded-3xl border border-white/10 hover:border-primary transition-colors flex flex-col items-center text-center">
            <i class="material-symbols-outlined text-5xl mb-6 text-primary-fixed not-italic" aria-hidden="true">forum</i>
            <h3 class="font-headline text-2xl font-bold mb-4">WhatsApp</h3>
            <p class="font-body text-surface/70 mb-8">Suporte rápido direto no seu celular. Disponível das 08h às 22h.</p>
            <a href="https://wa.me/5519900000000" target="_blank" rel="noopener noreferrer" class="w-full py-4 bg-[#25D366] text-white rounded-full font-bold hover:scale-[1.02] transition-transform flex items-center justify-center gap-2">
              Acessar Central WhatsApp
            </a>
          </li>

        </ul>
      </article>
    </section>

    <section id="chamado" class="px-8 py-24 scroll-mt-24" aria-labelledby="chamado-heading">
      <article class="max-w-3xl mx-auto bg-surface-container-lowest rounded-[2rem] p-8 md:p-12 shadow-xl shadow-on-surface/5">

        <header class="mb-8">
          <h2 id="chamado-heading" class="font-headline text-3xl md:text-4xl font-black tracking-tight text-on-surface mb-3">Abrir um chamado</h2>
          <p class="font-body text-on-surface-variant">Conte o que precisa. Nossa equipe de moderação recebe o seu chamado e responde por aqui mesmo.</p>
        </header>

        <% if (typeof erro !== 'undefined' && erro) { %>
          <p class="mb-6 rounded-2xl bg-error-container/20 text-error px-5 py-4 font-bold" role="alert"><%= erro %></p>
        <% } %>

        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
          <p class="mb-6 rounded-2xl bg-primary-container/20 text-primary px-5 py-4 font-bold" role="status"><%= sucesso %></p>
        <% } %>

        <% if (logado) { %>
          <form action="/suporte" method="POST" class="flex flex-col gap-6" novalidate>
            <fieldset class="flex flex-col gap-5">
              <legend class="sr-only">Dados do chamado</legend>

              <p class="font-body text-sm text-on-surface-variant">
                Enviando como <strong class="text-on-surface"><%= usuarioSuporte.nome %></strong>
                (<%= usuarioSuporte.tipo === 'professor' ? 'professor' : 'aluno' %>) · <%= usuarioSuporte.email %>
              </p>

              <section class="flex flex-col gap-2">
                <label for="assunto-chamado" class="text-xs font-black uppercase tracking-widest text-on-surface-variant">Assunto</label>
                <select id="assunto-chamado" name="assunto" required class="w-full rounded-2xl border-none bg-surface-container px-5 py-4 font-medium text-on-surface focus:ring-2 focus:ring-primary">
                  <option value="">Selecione o assunto</option>
                  <% assuntos.forEach(a => { %>
                    <option value="<%= a %>" <%= (typeof assuntoEscolhido !== 'undefined' && assuntoEscolhido === a) ? 'selected' : '' %>><%= a %></option>
                  <% }) %>
                </select>
              </section>

              <section class="flex flex-col gap-2">
                <label for="mensagem-chamado" class="text-xs font-black uppercase tracking-widest text-on-surface-variant">Mensagem</label>
                <textarea id="mensagem-chamado" name="mensagem" rows="6" minlength="10" maxlength="3000" required placeholder="Descreva o que aconteceu ou a sua dúvida com o máximo de detalhes." class="w-full rounded-2xl border-none bg-surface-container px-5 py-4 font-medium text-on-surface focus:ring-2 focus:ring-primary resize-y"><%= typeof mensagemDigitada !== 'undefined' ? mensagemDigitada : '' %></textarea>
                <small class="text-xs text-on-surface-variant">Mínimo de 10 caracteres.</small>
              </section>
            </fieldset>

            <button type="submit" class="w-full sm:w-auto sm:self-start bg-primary text-on-primary px-10 py-4 rounded-full font-bold shadow-lg shadow-primary/20 hover:bg-primary-dim transition-colors">
              Enviar chamado
            </button>
          </form>
        <% } else { %>
          <section class="flex flex-col items-start gap-5">
            <p class="font-body text-on-surface-variant text-lg">
              Para enviar um chamado você precisa estar logado, assim a equipe sabe quem você é e consegue responder.
            </p>
            <a href="/login?next=%2Fsuporte%23chamado" class="bg-primary text-on-primary px-10 py-4 rounded-full font-bold shadow-lg shadow-primary/20 hover:bg-primary-dim transition-colors">
              Fazer login para abrir chamado
            </a>
          </section>
        <% } %>

      </article>
    </section>

  </main>


  <script>
    (() => {
      const input = document.getElementById('busca-suporte');
      const searchButton = input?.parentElement?.querySelector('button[type="submit"]');
      const faqItems = [...document.querySelectorAll('[data-faq-item]')];
      const faqBlocos = [...document.querySelectorAll('[data-faq-bloco]')];
      const quickCards = [...document.querySelectorAll('[data-support-quick]')];
      const vazio = document.getElementById('faq-vazio');
      const normalizar = texto => (texto || '').toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

      function searchSupport(rolar) {
        const query = normalizar((input?.value || '').trim());
        let matches = 0;

        faqItems.forEach(item => {
          const match = !query || normalizar(item.textContent).includes(query);
          item.hidden = !match;
          if (match) matches++;
          const detalhes = item.querySelector('details');
          if (detalhes) detalhes.open = !!query && match && matches <= 3;
        });

        faqBlocos.forEach(bloco => {
          bloco.hidden = ![...bloco.querySelectorAll('[data-faq-item]')].some(i => !i.hidden);
        });

        quickCards.forEach(card => {
          card.hidden = !!query && !normalizar(card.textContent).includes(query) && !document.querySelector('#faq-bloco-' + card.dataset.supportQuick + ' [data-faq-item]:not([hidden])');
        });

        vazio?.classList.toggle('hidden', matches > 0);

        if (rolar && query) document.getElementById('faq-heading')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      input?.addEventListener('input', () => searchSupport(false));
      input?.addEventListener('keydown', event => { if (event.key === 'Enter') { event.preventDefault(); searchSupport(true); } });
      searchButton?.addEventListener('click', event => { event.preventDefault(); searchSupport(true); });

      quickCards.forEach(card => {
        const openTarget = () => {
          if (input && input.value) { input.value = ''; searchSupport(false); }
          const alvo = document.getElementById('faq-bloco-' + card.dataset.supportQuick);
          if (!alvo) return;
          alvo.scrollIntoView({ behavior: 'smooth', block: 'start' });
          alvo.classList.add('faq-bloco-destaque');
          setTimeout(() => alvo.classList.remove('faq-bloco-destaque'), 1600);
        };
        card.addEventListener('click', openTarget);
        card.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openTarget(); } });
      });
      document.addEventListener('DOMContentLoaded', () => {
      const seta = document.getElementById('seta-contato');
      const contato = document.getElementById('contato');

      if (seta && contato) {
        seta.addEventListener('click', event => {
          event.preventDefault();
          contato.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        if ('IntersectionObserver' in window) {
          new IntersectionObserver(entries => {
            seta.classList.toggle('seta-oculta', entries[0].isIntersecting);
          }, { threshold: 0.15 }).observe(contato);
        }
      }
      });
    })();
  </script>

  <a
    id="seta-contato"
    href="#contato"
    class="seta-contato fixed right-4 md:right-8 bottom-24 lg:bottom-8 z-40 inline-flex items-center gap-2 rounded-full bg-primary text-on-primary pl-5 pr-4 py-3 font-bold shadow-xl shadow-primary/30 hover:bg-primary-dim active:scale-95 transition-all duration-300"
    aria-label="Descer até a seção Ainda precisa de ajuda?">
    <em class="not-italic hidden sm:inline text-sm">Ainda precisa de ajuda?</em>
    <i class="material-symbols-outlined not-italic seta-contato-icone" aria-hidden="true">keyboard_double_arrow_down</i>
  </a>

  <nav class="lg:hidden fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 pb-6 pt-2 bg-[#f7f5ff]/90 dark:bg-[#1a1b26]/90 backdrop-blur-lg shadow-[0_-10px_40px_rgba(35,44,81,0.08)] rounded-t-[32px]" aria-label="Navegação mobile">

    <a href="/home" class="mobile-link flex flex-col items-center justify-center text-[#232c51] dark:text-[#d5dbff] opacity-60 p-3 hover:opacity-100 transition-opacity" data-page="home">
      <i class="material-symbols-outlined not-italic" aria-hidden="true">home</i>
      <em class="text-[10px] font-semibold tracking-wide uppercase mt-1 not-italic">Início</em>
    </a>

    <a href="/planos" class="mobile-link flex flex-col items-center justify-center text-[#232c51] dark:text-[#d5dbff] opacity-60 p-3 hover:opacity-100 transition-opacity" data-page="planos">
      <i class="material-symbols-outlined not-italic" aria-hidden="true">stars</i>
      <em class="text-[10px] font-semibold tracking-wide uppercase mt-1 not-italic">Planos</em>
    </a>

    <a href="/suporte" class="mobile-link flex flex-col items-center justify-center text-[#232c51] dark:text-[#d5dbff] opacity-60 p-3 hover:opacity-100 transition-opacity" data-page="suporte">
      <i class="material-symbols-outlined not-italic" aria-hidden="true">support_agent</i>
      <em class="text-[10px] font-semibold tracking-wide uppercase mt-1 not-italic">Suporte</em>
    </a>

  </nav>

  <script>
    const paginaAtual = window.location.pathname.split("/").pop().replace(".html", "") || "home"
    const linksMobile = document.querySelectorAll(".mobile-link")

    linksMobile.forEach(link => {
      const paginaDoLink = link.dataset.page

      if (paginaAtual === paginaDoLink) {
        link.classList.add("ativo")
        link.setAttribute("aria-current", "page")
      }
    })
  </script>
  
<script src="/js/transicao-paginas.js"></script>
  
</body>
</html>